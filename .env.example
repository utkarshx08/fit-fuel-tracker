# ==========================================
# FitFuel 2.0 Environment Configuration
# ==========================================

# Supabase Authentication & Database
# Get these from your Supabase Project Settings -> API
# Format: https://<project-id>.supabase.co (do NOT append /rest/v1/)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# USDA FoodData Central Nutrition API
# Free key can be generated at: https://fdc.nal.usda.gov/api-key-signup.html
# If left blank, FitFuel automatically uses Open Food Facts + Built-in verified database
VITE_USDA_API_KEY=DEMO_KEY
